{
  "name": "@rockygpt/data",
  "version": "0.1.0",
  "private": true,
  "description": "Campus data for RockyGPT: the repository layer, ingestion scrapers, publication pipeline, and the artifacts they produce.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:assets",
    "prepare": "npm run build",
    "build:assets": "node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "data:schema": "tsx pipeline/commands/apply-schema.ts",
    "data:quality": "tsx pipeline/commands/check-quality.ts",
    "data:publish": "tsx pipeline/commands/publish-current.ts",
    "data:bootstrap": "tsx pipeline/commands/restore-active-release.ts",
    "docs:graph": "tsx pipeline/commands/describe-graph.ts",
    "maintenance:data-retention": "tsx scripts/database/data-retention.ts",
    "fetch:menu": "tsx ingestion/birch-menu.ts",
    "fetch:dining-hours": "tsx ingestion/dining-hours.ts",
    "fetch:events": "tsx ingestion/archway-events.ts",
    "fetch:events:live": "EVENTS_FORCE_SCRAPE=1 tsx ingestion/archway-events.ts",
    "fetch:archway": "npm run fetch:events",
    "fetch:hours": "tsx ingestion/campus-hours.ts",
    "fetch:clubs": "tsx ingestion/archway-clubs.ts",
    "fetch:calendar": "tsx ingestion/academic-calendar.ts",
    "fetch:faculty": "tsx ingestion/faculty-profiles.ts",
    "fetch:map:rooms": "tsx ingestion/enrich-map-office-rooms.ts",
    "fetch:map:ids": "tsx ingestion/campus-map-ids.ts",
    "fetch:transportation:raw": "tsx ingestion/transportation-raw.ts",
    "fetch:directory:raw": "tsx ingestion/directory-raw.ts",
    "fetch:reviewed-contacts": "tsx ingestion/reviewed-contacts-raw.ts",
    "fetch:reviewed-contact-documents": "tsx ingestion/reviewed-contact-documents.ts",
    "normalize:reviewed-contact-documents": "tsx ingestion/reviewed-contact-documents.ts --replay",
    "fetch:housing:raw": "tsx ingestion/housing-raw.ts",
    "fetch:health:raw": "tsx ingestion/health-raw.ts",
    "fetch:counseling:raw": "tsx ingestion/counseling-raw.ts",
    "fetch:safety:raw": "tsx ingestion/safety-raw.ts",
    "fetch:programs:catalog": "tsx ingestion/scrape-catalog-api.ts",
    "fetch:course-subjects": "tsx ingestion/course-subjects.ts",
    "fetch:graduation-plans": "tsx ingestion/graduation-plans.ts",
    "fetch:major-pages": "tsx ingestion/major-pages.ts",
    "fetch:major-page-links": "tsx ingestion/major-page-links.ts",
    "fetch:office-pages": "tsx ingestion/office-pages.ts",
    "replay:raw": "tsx ingestion/replay-raw.ts",
    "fetch:catalog-policies": "tsx ingestion/catalog-policies.ts",
    "fetch:academic-sites": "tsx ingestion/academic-sites.ts",
    "fetch:athletics-schedules": "tsx ingestion/athletics.ts schedules",
    "fetch:athletics-coaches": "tsx ingestion/athletics.ts coaches",
    "fetch:athletics-pages": "tsx ingestion/athletics.ts pages",
    "check:contacts": "tsx scripts/check-contact-evidence.ts",
    "normalize:raw": "npm run normalize:reviewed-contact-documents && tsx ingestion/normalize-raw.ts",
    "quality:raw": "tsx scripts/database/quality-gates.ts --raw",
    "check:pages": "tsx ingestion/page-check.ts",
    "refresh": "npm run fetch:menu && npm run fetch:dining-hours && npm run fetch:events:live && npm run fetch:hours && npm run fetch:clubs && npm run data:quality",
    "refresh:all": "npm run fetch:menu && npm run fetch:dining-hours && npm run fetch:events:live && npm run fetch:hours && npm run fetch:clubs && npm run fetch:calendar && npm run fetch:faculty && npm run normalize:raw && npm run data:quality",
    "refresh:daily": "npm run fetch:menu && npm run fetch:events:live && npm run data:quality",
    "refresh:weekly": "npm run fetch:dining-hours && npm run data:quality",
    "refresh:monthly": "npm run fetch:clubs && npm run data:quality",
    "refresh:semesterly": "npm run fetch:hours && npm run fetch:calendar && npm run fetch:faculty && npm run fetch:programs:catalog && npm run refresh:raw:core6 && npm run normalize:raw && npm run data:quality",
    "refresh:lifetime": "npm run fetch:map:rooms",
    "refresh:raw:core6": "npm run fetch:transportation:raw && npm run fetch:directory:raw && npm run fetch:housing:raw && npm run fetch:health:raw && npm run fetch:counseling:raw && npm run fetch:safety:raw",
    "refresh:raw": "RAW_ONLY=1 npm run fetch:menu && RAW_ONLY=1 npm run fetch:dining-hours && RAW_ONLY=1 npm run fetch:events:live && RAW_ONLY=1 npm run fetch:hours && RAW_ONLY=1 npm run fetch:clubs && RAW_ONLY=1 npm run fetch:calendar && RAW_ONLY=1 npm run fetch:faculty && RAW_ONLY=1 npm run fetch:programs:catalog && RAW_ONLY=1 npm run refresh:raw:core6 && npm run quality:raw",
    "refresh:publishable": "tsx ingestion/refresh-publishable.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "p-limit": "^7.3.0",
    "pdf-parse": "2.4.5",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1087.0",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.16.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rocky-GPT/rockygpt-data.git"
  },
  "license": "UNLICENSED",
  "overrides": {
    "@aws-sdk/core": "3.977.8"
  }
}
